// Allow the consul user to send SIGHUP to consul.service via `systemctl kill`,
// so the vault-agent.service can trigger a TLS reload after rotating the
// server cert.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "consul.service" &&
        action.lookup("verb") === "kill" &&
        subject.user === "consul") {
        return polkit.Result.YES;
    }
});
