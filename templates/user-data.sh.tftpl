#!/bin/sh
# setup-consul-server.sh — Bootstrap a Consul Enterprise server node on EC2.
#
# This script is rendered by Terraform using templatefile() and placed in
# EC2 instance user data.
#
# Assumes:
#   - Ubuntu or Debian
#   - IAM instance profile with permissions for Secrets Manager, SSM, S3, EC2
#   - Consul gossip key and Enterprise license stored in AWS Secrets Manager
#   - Consul TLS materials issued on demand from Vault's PKI secrets engine
#   - Vault AWS auth role bound to the instance's IAM role
#   - Vault CA bundle published to AWS SSM Parameter Store

# shellcheck disable=SC2034,SC2154,SC2170,SC2269
# SC2034/SC2154:
# Variables are set via Terraform templatefile() interpolation and referenced
# with escaped dollar signs — shellcheck cannot parse either.
# SC2170:
# $${var} comparisons resolve to valid integers at runtime.
# SC2269:
# consul_version="${consul_version}" is not self-assignment — the RHS is a
# Terraform interpolation replaced at plan time.

set -ef

# ---------------------------------------------------------------------------
# Configuration — values templated by Terraform at deploy time
# ---------------------------------------------------------------------------

# Consul
consul_version="${consul_version}"
consul_data_dir="/opt/consul/data"
consul_config_dir="/etc/consul.d"
consul_license_path="/opt/consul/consul.hclic"

# An EBS data volume backs Raft state + local snapshots.
# ebs_data_device_name is the attachment name from Terraform (e.g. /dev/xvdf).
# On Nitro instances this appears as /dev/nvme*n1 and ebsnvme-id resolves it.
ebs_data_device_name="${ebs_device_name}"
ebs_data_mount="/opt/consul"
ebs_data_filesystem="xfs"

# TLS
tls_ca_file="/opt/consul/tls/ca.crt"
tls_cert_file="/opt/consul/tls/server.crt"
tls_key_file="/opt/consul/tls/server.key"
vault_ca_file="/opt/consul/tls/vault-ca.pem"

# Snapshot Agent
snapshot_config_file="/opt/consul/snapshot-agent.json"
snapshot_token_file="/opt/consul/snapshot-token"

# AWS
aws_region="${region}"

# AWS Secrets Manager (ARNs)
secret_consul_license="${consul_license_secret_arn}"
secret_consul_gossip_key="${consul_gossip_key_secret_arn}"

# AWS SSM Parameter Store
vault_ca_bundle_ssm_name="${vault_ca_bundle_ssm_name}"

# Vault
vault_version="${vault_version}"
vault_addr="${vault_addr}"
vault_pki_mount="${vault_pki_mount}"
vault_pki_role="${vault_pki_role}"
vault_aws_auth_role="${vault_aws_auth_role}"
consul_server_cert_ttl="${consul_server_cert_ttl}"

# Cluster identity
consul_fqdn="${consul_fqdn}"
consul_datacenter="${consul_datacenter}"
route53_zone_name="${route53_zone_name}"

# Cluster coordination
consul_cluster_tag_key="${consul_cluster_tag_key}"
consul_cluster_tag_value="${consul_cluster_tag_value}"
consul_cluster_state_ssm_name="${consul_cluster_state_ssm_name}"

# PKI and TLS
consul_pki_state_ssm_name="${consul_pki_state_ssm_name}"
consul_pki_intermediate_ca_csr_ssm_name="${consul_pki_intermediate_ca_csr_ssm_name}"
consul_pki_intermediate_ca_signed_csr_secret_arn="${consul_pki_intermediate_ca_signed_csr_secret_arn}"
consul_pki_signed_intermediate_wait_timeout_seconds="${consul_pki_signed_intermediate_wait_timeout_seconds}"
consul_tls_ca_bundle_ssm_name="${consul_tls_ca_bundle_ssm_name}"

# AWS Secrets Manager (ARNs) — bootstrap tokens
secret_consul_bootstrap_token="${consul_bootstrap_token_secret_arn}"
secret_consul_agent_token="${consul_agent_token_secret_arn}"

# EC2 metadata service (IMDSv2)
imds_endpoint="http://169.254.169.254"
imds_token_ttl="21600"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log_info() {
  printf '[INFO]  %s\n' "$${1}"
}

log_warn() {
  printf '[WARN]  %s\n' "$${1}" >&2
}

log_error() {
  printf '[ERROR] %s\n' "$${1}" >&2
}

# ---------------------------------------------------------------------------
# EC2 metadata helpers (IMDSv2)
# ---------------------------------------------------------------------------

imds_token() {
  curl -s -X PUT \
    -H "X-aws-ec2-metadata-token-ttl-seconds: $${imds_token_ttl}" \
    "$${imds_endpoint}/latest/api/token"
}

imds_get() {
  path="$${1}"
  token="$${2}"
  curl -s -H "X-aws-ec2-metadata-token: $${token}" \
    "$${imds_endpoint}/latest/meta-data/$${path}"
}

get_private_ip() {
  token="$(imds_token)"
  imds_get "local-ipv4" "$${token}"
}

get_availability_zone() {
  token="$(imds_token)"
  imds_get "placement/availability-zone" "$${token}"
}

get_instance_id() {
  token="$(imds_token)"
  imds_get "instance-id" "$${token}"
}

# ---------------------------------------------------------------------------
# AWS Secrets Manager helper
# ---------------------------------------------------------------------------

fetch_secret() {
  secret_arn="$${1}"
  aws secretsmanager get-secret-value \
    --secret-id "$${secret_arn}" \
    --region "$${aws_region}" \
    --query 'SecretString' \
    --output text
}

put_secret() {
  secret_arn="$${1}"
  secret_value="$${2}"

  aws secretsmanager put-secret-value \
    --secret-id "$${secret_arn}" \
    --secret-string "$${secret_value}" \
    --region "$${aws_region}" \
    >/dev/null
}

# ---------------------------------------------------------------------------
# AWS SSM Parameter Store helper
# ---------------------------------------------------------------------------

fetch_ssm_parameter() {
  name="$${1}"
  aws ssm get-parameter \
    --name "$${name}" \
    --region "$${aws_region}" \
    --query 'Parameter.Value' \
    --output text
}

put_ssm_parameter() {
  name="$${1}"
  value="$${2}"

  aws ssm put-parameter \
    --name "$${name}" \
    --value "$${value}" \
    --overwrite \
    --region "$${aws_region}" \
    >/dev/null
}

# ---------------------------------------------------------------------------
# Consul cluster discovery (bootstrap node election)
# ---------------------------------------------------------------------------

is_bootstrap_node() {
  instance_id="$(get_instance_id)"

  all_ids="$(
    aws ec2 describe-instances \
      --filters \
      "Name=tag:$${consul_cluster_tag_key},Values=$${consul_cluster_tag_value}" \
      "Name=instance-state-name,Values=running" \
      --query "Reservations[].Instances[].InstanceId" \
      --region "$${aws_region}" \
      --output text
  )"

  lowest_id="$(printf '%s' "$${all_ids}" | tr '\t' '\n' | sort | head -1)"

  [ "$${instance_id}" = "$${lowest_id}" ]
}

get_consul_node_role() {
  cluster_state="$(fetch_ssm_parameter "$${consul_cluster_state_ssm_name}" 2>/dev/null)" || cluster_state=""

  if [ "$${cluster_state}" = "Ready" ]; then
    printf 'follower'
  else
    if is_bootstrap_node; then
      printf 'bootstrap'
    else
      printf 'follower'
    fi
  fi
}

# ---------------------------------------------------------------------------
# System preparation
# ---------------------------------------------------------------------------

prepare_system() {
  log_info "Preparing system packages and directories"

  export DEBIAN_FRONTEND=noninteractive

  apt-get update -qq
  apt-get install -y -qq unzip curl jq nvme-cli amazon-ec2-utils gnupg

  # Create consul system user (server processes run as consul)
  if ! id -u consul >/dev/null 2>&1; then
    useradd --system --home /etc/consul.d --shell /bin/false consul
  fi

  # Directories on root volume
  mkdir -p "$${consul_config_dir}/tls"
  mkdir -p "$${consul_data_dir}"
  mkdir -p "$(dirname "$${snapshot_config_file}")"

  chown -R consul:consul "$${consul_config_dir}"
  chown -R consul:consul "$${consul_data_dir}"
}

# ---------------------------------------------------------------------------
# EBS data volume — discover, format, and mount
# ---------------------------------------------------------------------------

resolve_ebs_nvme_device() {
  target_name="$${1}"

  # Strip leading /dev/ from target for comparison — ebsnvme-id returns
  # the short form (e.g. "sdf") on some versions and the full path on others.
  target_short="$${target_name#/dev/}"

  # 60 attempts x 10s = 10 minutes.
  max_attempts=60
  attempt=0
  while [ "$${attempt}" -lt "$${max_attempts}" ]; do
    attempt=$((attempt + 1))
    # Globbing is disabled by set -f; re-enable for the device scan.
    set +f
    for nvme in /dev/nvme*n1; do
      [ -e "$${nvme}" ] || continue

      # ebsnvme-id -b prints the block device name the volume was attached as.
      attached="$(ebsnvme-id -b "$${nvme}" 2>/dev/null)" || continue
      attached_short="$${attached#/dev/}"

      if [ "$${attached_short}" = "$${target_short}" ]; then
        set -f
        printf '%s' "$${nvme}"
        return 0
      fi
    done
    set -f

    sleep 5
  done

  return 1
}

mount_data_volume() {
  log_info "Resolving EBS volume attached as $${ebs_data_device_name}"

  if ! command -v ebsnvme-id >/dev/null 2>&1; then
    log_error "ebsnvme-id not found — ensure amazon-ec2-utils is installed in the AMI"
    return 1
  fi

  device="$(resolve_ebs_nvme_device "$${ebs_data_device_name}")" || {
    log_error "No NVMe device found matching EBS attachment $${ebs_data_device_name}"
    return 1
  }

  log_info "Matched $${ebs_data_device_name} -> $${device}"

  # Format only if the device has no existing filesystem
  if ! blkid -p "$${device}" >/dev/null 2>&1; then
    log_info "Formatting $${device} as $${ebs_data_filesystem}"
    "mkfs.$${ebs_data_filesystem}" "$${device}"
  else
    log_info "Filesystem already present on $${device}, skipping format"
  fi

  # Mount
  mkdir -p "$${ebs_data_mount}"
  mount -t "$${ebs_data_filesystem}" "$${device}" "$${ebs_data_mount}"
  log_info "Mounted $${device} at $${ebs_data_mount}"

  # Persist in fstab (use UUID for stability across reboots)
  uuid="$(blkid -s UUID -o value "$${device}")"
  if ! grep -q "$${uuid}" /etc/fstab; then
    printf 'UUID=%s  %s  %s  defaults,nofail  0  2\n' \
      "$${uuid}" "$${ebs_data_mount}" "$${ebs_data_filesystem}" \
      >>/etc/fstab
    log_info "Added fstab entry for UUID=$${uuid}"
  fi

  # Create subdirectories on the mounted volume
  mkdir -p "$${consul_data_dir}"
  chown -R consul:consul "$${ebs_data_mount}"
}

# ---------------------------------------------------------------------------
# HashiCorp release download + verification helpers
# ---------------------------------------------------------------------------

detect_system_architecture() {
  machine="$(uname -m)"
  case "$${machine}" in
    x86_64) printf 'amd64' ;;
    aarch64) printf 'arm64' ;;
    *)
      log_error "Unsupported architecture: $${machine}"
      return 1
      ;;
  esac
}

import_hashicorp_pgp_key() {
  tmp_dir="$${1}"

  export GNUPGHOME="$${tmp_dir}/.gnupg"
  mkdir -p "$${GNUPGHOME}"
  chmod 0700 "$${GNUPGHOME}"

  curl -fsSL -o "$${tmp_dir}/hashicorp.asc" \
    https://www.hashicorp.com/.well-known/pgp-key.txt
  gpg --quiet --import "$${tmp_dir}/hashicorp.asc"
  printf '%s\n' "C874011F0AB405110D02105534365D9472D7468F:6:" | gpg --quiet --import-ownertrust
}

download_and_verify_release() {
  product="$${1}"
  version="$${2}"
  arch="$${3}"
  tmp_dir="$${4}"

  base_url="https://releases.hashicorp.com/$${product}/$${version}"
  zip_file="$${product}_$${version}_linux_$${arch}.zip"
  sums_file="$${product}_$${version}_SHA256SUMS"
  sig_file="$${product}_$${version}_SHA256SUMS.sig"

  curl -fsSL -o "$${tmp_dir}/$${zip_file}" "$${base_url}/$${zip_file}"
  curl -fsSL -o "$${tmp_dir}/$${sums_file}" "$${base_url}/$${sums_file}"
  curl -fsSL -o "$${tmp_dir}/$${sig_file}" "$${base_url}/$${sig_file}"

  import_hashicorp_pgp_key "$${tmp_dir}"

  log_info "Verifying GPG signature for $${product} $${version}"
  gpg --quiet --verify "$${tmp_dir}/$${sig_file}" "$${tmp_dir}/$${sums_file}"

  log_info "Verifying SHA256 checksum for $${product} $${version}"
  cd "$${tmp_dir}" || return 1
  sha256sum -c --ignore-missing "$${sums_file}"
  cd / || return 1
}

# ---------------------------------------------------------------------------
# Install Consul Enterprise
# ---------------------------------------------------------------------------

install_consul() {
  log_info "Installing Consul Enterprise $${consul_version}"
  tmp_dir="$(mktemp -d)"

  arch="$(detect_system_architecture)"
  download_and_verify_release "consul" "$${consul_version}" "$${arch}" "$${tmp_dir}"

  unzip -o -q "$${tmp_dir}/consul_$${consul_version}_linux_$${arch}.zip" -d "$${tmp_dir}"
  mv "$${tmp_dir}/consul" /usr/local/bin/consul
  chmod 0755 /usr/local/bin/consul
  rm -rf "$${tmp_dir}"

  consul version
}

# ---------------------------------------------------------------------------
# Install Vault CLI (used only to authenticate and issue PKI certificates)
# ---------------------------------------------------------------------------

install_vault() {
  log_info "Installing Vault CLI $${vault_version}"
  tmp_dir="$(mktemp -d)"

  arch="$(detect_system_architecture)"
  download_and_verify_release "vault" "$${vault_version}" "$${arch}" "$${tmp_dir}"

  unzip -o -q "$${tmp_dir}/vault_$${vault_version}_linux_$${arch}.zip" -d "$${tmp_dir}"
  mv "$${tmp_dir}/vault" /usr/local/bin/vault
  chmod 0755 /usr/local/bin/vault
  rm -rf "$${tmp_dir}"

  vault version
}

# ---------------------------------------------------------------------------
# Vault Authentication
# ---------------------------------------------------------------------------

authenticate_to_vault() {
  log_info "Fetching Vault CA bundle from SSM ($${vault_ca_bundle_ssm_name})"

  mkdir -p "$(dirname "$${vault_ca_file}")"
  fetch_ssm_parameter "$${vault_ca_bundle_ssm_name}" >"$${vault_ca_file}"
  chmod 0644 "$${vault_ca_file}"

  export VAULT_ADDR="$${vault_addr}"
  export VAULT_CACERT="$${vault_ca_file}"

  log_info "Authenticating to Vault via AWS IAM auth"
  vault_token="$(
    vault login \
      -format=json \
      -method=aws \
      role="$${vault_aws_auth_role}" |
      jq -r '.auth.client_token'
  )"
  export VAULT_TOKEN="$${vault_token}"
}

# ---------------------------------------------------------------------------
# Configure Consul PKI Engine
# ---------------------------------------------------------------------------

configure_consul_pki_intermediate_ca() {
  log_info "Configuring Consul PKI intermediate CA"

  tmp_dir="$(mktemp -d)"

  vault write "$${vault_pki_mount}/config/urls" - >/dev/null <<EOF
{
  "issuing_certificates": "$${vault_addr}/v1/$${vault_pki_mount}/ca",
  "crl_distribution_points": "$${vault_addr}/v1/$${vault_pki_mount}/crl",
  "ocsp_servers": "$${vault_addr}/v1/$${vault_pki_mount}/ocsp"
}
EOF

  # Generate the intermediate CSR inside Vault (private key never leaves)
  log_info "Generating intermediate CSR"
  csr_pem="$(
    vault write -format=json "$${vault_pki_mount}/intermediate/generate/internal" - <<EOF | jq -r '.data.csr'
{
  "common_name": "$${consul_fqdn} Consul Intermediate CA",
  "key_type": "ec",
  "key_bits": 384
}
EOF
  )"

  # Publish the CSR to SSM for an external process to sign
  log_info "Publishing intermediate CSR to $${consul_pki_intermediate_ca_csr_ssm_name}"
  put_ssm_parameter "$${consul_pki_intermediate_ca_csr_ssm_name}" "$${csr_pem}"

  # Wait for the externally signed certificate to appear in Secrets Manager
  log_info "Waiting for externally signed intermediate certificate"
  signed_json="$(fetch_signed_intermediate)"

  # Validate the signed material payload
  if printf '%s' "$${signed_json}" | jq -e '.private_key // empty' >/dev/null 2>&1; then
    log_error "Signed intermediate payload contains a private_key field — this is a contract violation, aborting"
    return 1
  fi

  signed_cert="$(printf '%s' "$${signed_json}" | jq -r '.certificate // empty')"
  ca_chain="$(printf '%s' "$${signed_json}" | jq -r '.ca_chain // empty')"

  if [ -z "$${signed_cert}" ]; then
    log_error "Signed intermediate payload is missing the certificate field"
    return 1
  fi

  if [ -z "$${ca_chain}" ]; then
    log_error "Signed intermediate payload is missing the ca_chain field"
    return 1
  fi

  # Cache the CA chain for publish_consul_tls_ca_bundle
  CONSUL_PKI_INTERMEDIATE_CA_CHAIN="$${ca_chain}"

  # Import only the signed intermediate certificate (not the full chain).
  # Including the root CA in the bundle prevents Vault from linking the
  # issuer to the existing key generated by generate/internal.
  printf '%s\n' "$${signed_cert}" >"$${tmp_dir}/consul_intermediate.pem"
  imported_issuer_id="$(
    vault write -format=json "$${vault_pki_mount}/intermediate/set-signed" \
      certificate=@"$${tmp_dir}/consul_intermediate.pem" |
      jq -r '.data.mapping | to_entries[] | select(.value != "") | .key'
  )"

  rm -rf "$${tmp_dir}"

  # Set the imported issuer as the default so cert/ca and issue endpoints work
  vault write "$${vault_pki_mount}/config/issuers" \
    default="$${imported_issuer_id}" \
    >/dev/null

  log_info "Intermediate CA signed and imported"
}

configure_consul_server_pki_role() {
  log_info "Creating $${vault_pki_role} PKI role"

  vault write "$${vault_pki_mount}/roles/$${vault_pki_role}" - >/dev/null <<EOF
{
  "allowed_domains": "$${route53_zone_name},$${consul_datacenter}.consul",
  "allow_bare_domains": true,
  "allow_subdomains": true,
  "allow_glob_domains": true,
  "allow_localhost": true,
  "allow_ip_sans": true,
  "key_type": "ec",
  "key_bits": 384,
  "ext_key_usage": ["ServerAuth", "ClientAuth"],
  "max_ttl": "86400s"
}
EOF

  log_info "$${vault_pki_role} PKI role created"
}

fetch_signed_intermediate() {
  interval=10
  max_attempts=$((consul_pki_signed_intermediate_wait_timeout_seconds / interval))
  attempt=0

  while [ "$${attempt}" -lt "$${max_attempts}" ]; do
    attempt=$((attempt + 1))

    secret_value="$(aws secretsmanager get-secret-value \
      --secret-id "$${consul_pki_intermediate_ca_signed_csr_secret_arn}" \
      --region "$${aws_region}" \
      --query SecretString --output text 2>/dev/null)" || secret_value=""

    if [ -n "$${secret_value}" ] && printf '%s' "$${secret_value}" | jq -e '.certificate' >/dev/null 2>&1; then
      printf '%s' "$${secret_value}"
      return 0
    fi

    sleep "$${interval}"
  done

  log_error "Timed out after $${consul_pki_signed_intermediate_wait_timeout_seconds}s waiting for signed intermediate at $${consul_pki_intermediate_ca_signed_csr_secret_arn}"
  return 1
}

publish_consul_tls_ca_bundle() {
  log_info "Publishing Consul PKI TLS CA bundle to SSM"

  consul_pki_intermediate_ca_cert="$(vault read -field=certificate "$${vault_pki_mount}/cert/ca")"
  tls_ca_bundle="$(printf '%s\n%s\n' "$${consul_pki_intermediate_ca_cert}" "$${CONSUL_PKI_INTERMEDIATE_CA_CHAIN}")"
  put_ssm_parameter "$${consul_tls_ca_bundle_ssm_name}" "$${tls_ca_bundle}"
}

mark_pki_ready() {
  log_info "Writing PKI state: Ready"
  put_ssm_parameter "$${consul_pki_state_ssm_name}" "Ready"
}

wait_for_pki_ready() {
  log_info "Waiting for the bootstrap node to finish PKI setup"

  # 60 attempts x 10s = 10 minutes.
  max_attempts=60
  attempt=0
  while [ "$${attempt}" -lt "$${max_attempts}" ]; do
    attempt=$((attempt + 1))

    state="$(fetch_ssm_parameter "$${consul_pki_state_ssm_name}")" || true
    if [ "$${state}" = "Ready" ]; then
      log_info "PKI is ready, proceeding"
      return 0
    fi

    log_info "PKI is not ready (attempt $${attempt}/$${max_attempts}), waiting"
    sleep 10
  done

  log_error "PKI was not ready after $${max_attempts} attempts, failing bootstrap"
  return 1
}

# ---------------------------------------------------------------------------
# Issue Consul server TLS materials from Vault PKI
# ---------------------------------------------------------------------------

issue_consul_tls_from_vault() {
  # Authenticate to Vault if not already authenticated (bootstrap node
  # authenticates during PKI setup).
  if [ -z "$${VAULT_TOKEN:-}" ]; then
    authenticate_to_vault
  fi

  log_info "Requesting Consul server certificate from $${vault_pki_mount}/issue/$${vault_pki_role}"
  cert_json="$(
    vault write -format=json "$${vault_pki_mount}/issue/$${vault_pki_role}" \
      common_name="$${consul_fqdn}" \
      alt_names="server.$${consul_datacenter}.consul,*.$${route53_zone_name},localhost" \
      ip_sans="127.0.0.1" \
      ttl="$${consul_server_cert_ttl}"
  )"

  mkdir -p "$(dirname "$${tls_ca_file}")"

  # Assemble the full chain of trust — issuing intermediate(s) + root.
  printf '%s\n' "$(printf '%s' "$${cert_json}" | jq -r '.data.issuing_ca')" >"$${tls_ca_file}"
  ca_chain="$(printf '%s' "$${cert_json}" | jq -r 'if (.data.ca_chain // []) | length > 0 then .data.ca_chain[] else empty end')"
  if [ -n "$${ca_chain}" ]; then
    printf '%s\n' "$${ca_chain}" >>"$${tls_ca_file}"
  fi

  printf '%s\n' "$(printf '%s' "$${cert_json}" | jq -r '.data.certificate')" >"$${tls_cert_file}"
  printf '%s\n' "$(printf '%s' "$${cert_json}" | jq -r '.data.private_key')" >"$${tls_key_file}"

  chown consul:consul "$${tls_ca_file}" "$${tls_cert_file}" "$${tls_key_file}"
  chmod 0640 "$${tls_ca_file}" "$${tls_cert_file}" "$${tls_key_file}"
}

# ---------------------------------------------------------------------------
# Fetch license + gossip key and write them to disk
# ---------------------------------------------------------------------------

write_secrets() {
  log_info "Fetching secrets from AWS Secrets Manager"

  consul_license="$(fetch_secret "$${secret_consul_license}")"
  gossip_key="$(fetch_secret "$${secret_consul_gossip_key}")"

  # Write the license file
  printf '%s' "$${consul_license}" >"$${consul_license_path}"
  chown consul:consul "$${consul_license_path}"
  chmod 0640 "$${consul_license_path}"
}

# ---------------------------------------------------------------------------
# Generate Consul server configuration
# ---------------------------------------------------------------------------

write_consul_config() {
  private_ip="$${1}"

  log_info "Writing Consul configuration (bind=$${private_ip})"

  # consul.hcl — contains $${gossip_key} and $${private_ip} shell variables,
  # needs unquoted heredoc.
  cat >"$${consul_config_dir}/consul.hcl" <<EOF
${config_server_consul_hcl}
EOF

  # --- Server stanza ---
  cat >"$${consul_config_dir}/server.hcl" <<'EOF'
${config_server_server_hcl}
EOF

  # Static configuration files — single-quoted heredocs (no shell expansion).
  cat >"$${consul_config_dir}/acl.hcl" <<'EOF'
${config_server_acl_hcl}
EOF

  cat >"$${consul_config_dir}/auto-encrypt.hcl" <<'EOF'
${config_server_auto_encrypt_hcl}
EOF

  cat >"$${consul_config_dir}/performance.hcl" <<'EOF'
${config_server_performance_hcl}
EOF

  cat >"$${consul_config_dir}/ports.hcl" <<'EOF'
${config_server_ports_hcl}
EOF

  cat >"$${consul_config_dir}/tls.hcl" <<'EOF'
${config_server_tls_hcl}
EOF

  cat >"$${consul_config_dir}/ui.hcl" <<'EOF'
${config_server_ui_hcl}
EOF

  chown -R consul:consul "$${consul_config_dir}"
  find "$${consul_config_dir}" -type f -name '*.hcl' -exec chmod 0640 {} \;
}

# ---------------------------------------------------------------------------
# Systemd unit — Consul server
# ---------------------------------------------------------------------------

write_consul_systemd_unit() {
  log_info "Writing Consul systemd unit"

  cat >/etc/systemd/system/consul.service <<'EOF'
${config_consul_service}
EOF
}

# ---------------------------------------------------------------------------
# Generate Consul Snapshot Agent configuration (Enterprise)
# ---------------------------------------------------------------------------

configure_snapshot_agent() {
  log_info "Writing Consul Snapshot Agent configuration"

  # Write the Consul Snapshot Agent configuration (must be JSON, not HCL).
  cat >"$${snapshot_config_file}" <<'EOF'
${config_snapshot_agent_json}
EOF
  chown consul:consul "$${snapshot_config_file}"
  chmod 0640 "$${snapshot_config_file}"

  # Write the token placeholder for the Consul Snapshot Agent.
  printf 'CONSUL_HTTP_TOKEN=\n' >"$${snapshot_token_file}"
  chown consul:consul "$${snapshot_token_file}"
  chmod 0600 "$${snapshot_token_file}"

  # Write the systemd unit for the Consul Snapshot Agent.
  cat >/etc/systemd/system/consul-snapshot-agent.service <<'EOF'
${config_snapshot_agent_service}
EOF

  systemctl daemon-reload
}

# ---------------------------------------------------------------------------
# Consul CLI environment
# ---------------------------------------------------------------------------

configure_consul_env() {
  export CONSUL_HTTP_ADDR="https://127.0.0.1:8501"
  export CONSUL_CACERT="$${tls_ca_file}"
  export CONSUL_CLIENT_CERT="$${tls_cert_file}"
  export CONSUL_CLIENT_KEY="$${tls_key_file}"
}

# ---------------------------------------------------------------------------
# ACL bootstrap and token provisioning
# ---------------------------------------------------------------------------

bootstrap_consul_acl() {
  log_info "Bootstrapping Consul ACL system"

  bootstrap_output="$(consul acl bootstrap -format=json)"
  bootstrap_token="$(printf '%s' "$${bootstrap_output}" | jq -r '.SecretID')"

  log_info "Storing bootstrap token in Secrets Manager"
  put_secret "$${secret_consul_bootstrap_token}" "$${bootstrap_token}"

  export CONSUL_HTTP_TOKEN="$${bootstrap_token}"

  log_info "ACL bootstrap complete"
}

create_agent_token() {
  log_info "Creating consul-server-agent ACL policy"

  consul acl policy create \
    -name "consul-server-agent" \
    -rules 'node_prefix "" { policy = "write" }
service_prefix "" { policy = "read" }' \
    >/dev/null 2>&1 || true

  log_info "Creating agent token"
  agent_token="$(
    consul acl token create \
      -description "Consul server agent token" \
      -policy-name "consul-server-agent" \
      -format=json | jq -r '.SecretID'
  )"

  log_info "Storing agent token in Secrets Manager"
  put_secret "$${secret_consul_agent_token}" "$${agent_token}"

  log_info "Agent token created and stored"
}

apply_agent_token() {
  log_info "Fetching agent token from Secrets Manager"
  agent_token="$(fetch_secret "$${secret_consul_agent_token}")"

  log_info "Setting agent token on local node"
  consul acl set-agent-token agent "$${agent_token}"

  log_info "Agent token applied"
}

mark_cluster_ready() {
  log_info "Writing cluster state: Ready"
  put_ssm_parameter "$${consul_cluster_state_ssm_name}" "Ready"
}

wait_for_bootstrap() {
  log_info "Waiting for the bootstrap node to initialize the ACL system"

  # 60 attempts x 5s = 5 minutes.
  max_attempts=60
  attempt=0
  while [ "$${attempt}" -lt "$${max_attempts}" ]; do
    attempt=$((attempt + 1))

    state="$(fetch_ssm_parameter "$${consul_cluster_state_ssm_name}")" || true
    if [ "$${state}" = "Ready" ]; then
      log_info "Cluster is initialized, proceeding"
      return 0
    fi

    log_info "Cluster is not initialized (attempt $${attempt}/$${max_attempts}), waiting"
    sleep 5
  done

  log_error "Cluster was not initialized after $${max_attempts} attempts"
  return 1
}

start_snapshot_agent() {
  log_info "Configuring snapshot agent with bootstrap token"

  bootstrap_token="$(fetch_secret "$${secret_consul_bootstrap_token}")"

  printf 'CONSUL_HTTP_TOKEN=%s\n' "$${bootstrap_token}" >"$${snapshot_token_file}"
  chown consul:consul "$${snapshot_token_file}"
  chmod 0600 "$${snapshot_token_file}"

  systemctl enable --now consul-snapshot-agent

  log_info "Snapshot agent started"
}

# ---------------------------------------------------------------------------
# Enable and start services
# ---------------------------------------------------------------------------

start_services() {
  log_info "Reloading systemd and enabling services"

  systemctl daemon-reload

  systemctl enable consul
  systemctl start consul

  # Wait for Consul to become available
  retries=0
  max_retries=30
  while [ "$${retries}" -lt "$${max_retries}" ]; do
    if curl -sf \
      --cacert "$${tls_ca_file}" \
      --cert "$${tls_cert_file}" \
      --key "$${tls_key_file}" \
      https://127.0.0.1:8501/v1/status/leader | grep -q '.'; then
      log_info "Consul server is accepting connections"
      break
    fi
    retries=$((retries + 1))
    log_info "Waiting for Consul server (attempt $${retries}/$${max_retries})..."
    sleep 5
  done

  if [ "$${retries}" -ge "$${max_retries}" ]; then
    log_warn "Consul did not become healthy within timeout"
  fi

  log_info "All services started"
}

# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------

main() {
  log_info "=== Consul Enterprise server bootstrap ==="

  private_ip="$(get_private_ip)"
  instance_id="$(get_instance_id)"

  log_info "Instance $${instance_id} at $${private_ip}"

  CONSUL_PKI_INTERMEDIATE_CA_CHAIN=""

  prepare_system
  mount_data_volume
  install_consul
  install_vault

  # Determine this node's role before PKI setup.
  consul_node_role="$(get_consul_node_role)"
  log_info "Node role: $${consul_node_role}"

  # PKI setup must complete before issuing leaf certificates.
  if [ "$${consul_node_role}" = "bootstrap" ]; then
    log_info "=== Bootstrap Node: Configuring PKI ==="
    authenticate_to_vault
    configure_consul_pki_intermediate_ca
    configure_consul_server_pki_role
    publish_consul_tls_ca_bundle
    mark_pki_ready
  else
    log_info "=== Follower Node: Waiting for PKI ==="
    wait_for_pki_ready
  fi

  issue_consul_tls_from_vault
  write_secrets
  write_consul_config "$${private_ip}"
  write_consul_systemd_unit
  configure_snapshot_agent

  start_services

  # Set up Consul CLI environment for ACL operations.
  configure_consul_env

  # ACL bootstrap and token provisioning.
  if [ "$${consul_node_role}" = "bootstrap" ]; then
    log_info "=== Bootstrap Node: Initializing ACL system ==="
    bootstrap_consul_acl
    create_agent_token
    apply_agent_token
    mark_cluster_ready
  else
    log_info "=== Follower Node: Waiting for ACL bootstrap ==="
    wait_for_bootstrap

    bootstrap_token="$(fetch_secret "$${secret_consul_bootstrap_token}")"
    export CONSUL_HTTP_TOKEN="$${bootstrap_token}"

    apply_agent_token
  fi

  start_snapshot_agent

  # Drop the Vault token; it is no longer needed.
  unset VAULT_TOKEN

  log_info "=== Bootstrap complete ==="
}

main "$${@}"
