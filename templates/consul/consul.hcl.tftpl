datacenter = "${datacenter}"
node_name  = "{{ v1.instance_id }}"

server           = true
bootstrap_expect = ${bootstrap_expect}

data_dir     = "/var/opt/consul/data"
license_path = "/opt/consul/consul.hclic"

retry_join = ["provider=aws region=${aws_region} tag_key=${auto_join_tag_key} tag_value=${auto_join_tag_value}"]

log_level = "${log_level}"
log_json  = ${log_json}

# The HTTP listener is disabled in favour of HTTPS; gRPC is unused without
# service mesh consumers (re-enable grpc_tls for consul-dataplane).
ports {
  http     = -1
  https    = 8501
  dns      = 8600
  grpc     = -1
  grpc_tls = -1
}

# client_addr defaults to loopback; expose only the HTTPS API so the NLB health
# check and external UI/API can reach it. 0.0.0.0 keeps loopback bound for the
# on-node bootstrap scripts. DNS and gRPC stay on loopback.
addresses {
  https = "0.0.0.0"
}

acl {
  enabled                  = true
  default_policy           = "deny"
  enable_token_persistence = true
}

tls {
  defaults {
    ca_file         = "/opt/consul/tls/ca.pem"
    cert_file       = "/opt/consul/tls/server.crt"
    key_file        = "/opt/consul/tls/server.key"
    tls_min_version = "TLSv1_3"
    verify_outgoing = true
  }

  internal_rpc {
    verify_incoming        = true
    verify_server_hostname = true
  }

  # The NLB health check cannot present a client certificate.
  https {
    verify_incoming = false
  }
}

audit {
  enabled = true

  sink "file" {
    type               = "file"
    format             = "json"
    path               = "/var/log/consul/audit.json"
    delivery_guarantee = "best-effort"
    rotate_duration    = "${audit_rotate_duration}"
    rotate_max_files   = ${audit_rotate_max_files}
  }
}

telemetry {
  prometheus_retention_time = "${prometheus_retention_time}"
  disable_hostname          = ${disable_hostname}
}

ui_config {
  enabled = ${ui}
}
